<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
  <FontFamily x:Key="Font.Sans">Microsoft YaHei UI, Segoe UI Variable, Segoe UI, Arial</FontFamily>
  <FontFamily x:Key="Font.Serif">Georgia, Microsoft YaHei</FontFamily>
  <SolidColorBrush x:Key="Surface.App" Color="#F4F3EE" po:Freeze="False" />
  <SolidColorBrush x:Key="Surface.Nav" Color="#E8E7E1" po:Freeze="False" />
  <SolidColorBrush x:Key="Surface.Card" Color="#FFFFFF" po:Freeze="False" />
  <SolidColorBrush x:Key="Surface.Selected" Color="#D1E0D6" po:Freeze="False" />
  <SolidColorBrush x:Key="Surface.Hover" Color="#EDF4EF" po:Freeze="False" />
  <SolidColorBrush x:Key="Text.Primary" Color="#242925" po:Freeze="False" />
  <SolidColorBrush x:Key="Text.Secondary" Color="#59625B" po:Freeze="False" />
  <SolidColorBrush x:Key="Text.Muted" Color="#6C726D" po:Freeze="False" />
  <SolidColorBrush x:Key="Brand" Color="#246047" po:Freeze="False" />
  <SolidColorBrush x:Key="Border" Color="#C8CAC2" po:Freeze="False" />
  <SolidColorBrush x:Key="Border.Subtle" Color="#D7D7D0" po:Freeze="False" />
  <SolidColorBrush x:Key="Focus" Color="#135F9F" po:Freeze="False" />

  <Style TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle">
      <Setter.Value><Style><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource Focus}" BorderThickness="3" Margin="-3" /></ControlTemplate></Setter.Value></Setter></Style></Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}" />
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                          Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <Grid>
                <ContentPresenter Margin="0,0,20,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Data="M 0 0 L 8 0 L 4 4 Z" />
              </Grid>
            </ToggleButton>
            <Popup x:Name="Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade">
              <Border MinWidth="{Binding ActualWidth, ElementName=Toggle}" Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" SnapsToDevicePixels="True">
                <ScrollViewer CanContentScroll="True" MaxHeight="220">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Brand}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="Background" Value="{DynamicResource Surface.Card}" />
    <Style.Triggers>
      <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource Brand}" /><Setter Property="Foreground" Value="White" /></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Surface.Selected}" /></Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
</ResourceDictionary>
