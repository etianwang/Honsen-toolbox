<Window x:Class="HonsenToolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HonsenToolbox"
        mc:Ignorable="d"
        Title="Honsen工具箱" Height="690" Width="1080" MinHeight="500" MinWidth="780"
        Background="{DynamicResource Surface.App}" FontFamily="{StaticResource Font.Sans}"
        Closing="Window_Closing" Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized" KeyDown="Window_KeyDown">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="MinHeight" Value="40" /><Setter Property="Margin" Value="0,2" /><Setter Property="Padding" Value="10,0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger><Trigger Property="Tag" Value="selected"><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource Surface.Selected}" /><Setter Property="Foreground" Value="{DynamicResource Brand}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ToolCard" TargetType="Button">
      <Setter Property="Height" Value="160" /><Setter Property="Margin" Value="0,0,12,12" /><Setter Property="Padding" Value="16" />
      <Setter Property="Background" Value="{DynamicResource Surface.Card}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brand}" /></Trigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <AdornerDecorator><DockPanel>
    <Border DockPanel.Dock="Top" Height="42" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
      <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="20" Height="20" Background="{DynamicResource Brand}"><TextBlock Text="H" Foreground="White" FontFamily="{StaticResource Font.Serif}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" /></Border>
        <TextBlock Grid.Column="1" Text="Honsen工具箱" VerticalAlignment="Center" Margin="10,0" FontWeight="SemiBold" />
        <Button Grid.Column="2" Click="Theme_Click" ToolTip="切换深色模式" AutomationProperties.Name="切换深色模式">◐</Button>
      </Grid>
    </Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="216" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource Surface.Nav}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,1,0" Padding="12">
        <StackPanel>
          <TextBlock Text="工具库" Foreground="{DynamicResource Text.Muted}" FontSize="12" FontWeight="SemiBold" Margin="8,8,8,10" />
          <Button x:Name="FavouriteNav" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="selected" AutomationProperties.Name="已收藏"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="27" VerticalAlignment="Center" /><TextBlock x:Name="FavouriteNavLabel" VerticalAlignment="Center" /></StackPanel></Button>
          <Button x:Name="AllNav" Style="{StaticResource NavButton}" Click="Nav_Click" AutomationProperties.Name="全部工具"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="27" VerticalAlignment="Center" /><TextBlock x:Name="AllNavLabel" VerticalAlignment="Center" /></StackPanel></Button>
          <Button x:Name="InstallNav" Style="{StaticResource NavButton}" Click="Nav_Click" AutomationProperties.Name="可安装"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="27" VerticalAlignment="Center" /><TextBlock x:Name="InstallNavLabel" VerticalAlignment="Center" /></StackPanel></Button>
          <Button x:Name="UpdatesNav" Style="{StaticResource NavButton}" Click="Nav_Click" AutomationProperties.Name="更新中心"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="27" VerticalAlignment="Center" /><TextBlock x:Name="UpdatesNavLabel" VerticalAlignment="Center" /></StackPanel></Button>
          <Separator Margin="8,24,8,12" />
          <TextBlock Text="语言" Foreground="{DynamicResource Text.Muted}" FontSize="12" Margin="8,0,8,6" />
          <ComboBox x:Name="LanguageBox" SelectionChanged="LanguageBox_SelectionChanged" SelectedIndex="0" Margin="0,0,0,12" AutomationProperties.Name="界面语言">
            <ComboBoxItem Content="简体中文" Tag="zh" /><ComboBoxItem Content="English" Tag="en" /><ComboBoxItem Content="Français" Tag="fr" />
          </ComboBox>
          <CheckBox x:Name="AutostartBox" Checked="Autostart_Changed" Unchecked="Autostart_Changed" Content="开机自动启动" IsChecked="True" Margin="8,4" />
          <TextBlock x:Name="NetworkStatus" Foreground="{DynamicResource Text.Muted}" FontSize="12" Margin="8,20,8,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,28">
        <DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left"><TextBlock x:Name="PageTitle" Text="收藏的工具" FontSize="28" FontWeight="SemiBold" /><TextBlock x:Name="PageDescription" Text="把最常用的入口固定在这里。" Foreground="{DynamicResource Text.Secondary}" Margin="0,6,0,0" /></StackPanel><Button x:Name="RepairInstallButton" DockPanel.Dock="Right" Click="RepairInstall_Click" Margin="0,0,12,0" Padding="12,0" Visibility="Collapsed" AutomationProperties.Name="修复已安装应用" />
          <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource Border}" BorderThickness="1" Background="{DynamicResource Surface.Card}" Height="38" Width="290"><DockPanel><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" /><TextBlock DockPanel.Dock="Right" Text="Ctrl K" Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="8,0" VerticalAlignment="Center" /><Button DockPanel.Dock="Right" Content="×" Click="ClearSearch_Click" ToolTip="清除搜索" AutomationProperties.Name="清除搜索" Padding="8,0" /><TextBox x:Name="SearchBox" BorderThickness="0" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="搜索所有工具" ToolTip="输入即可搜索所有工具" /></DockPanel></Border>
        </DockPanel>
        <TextBlock x:Name="SectionTitle" Text="已收藏" FontWeight="SemiBold" FontSize="14" Margin="0,32,0,12" />
        <Border x:Name="InstallProgressPanel" Visibility="Collapsed" Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16" AutomationProperties.Name="安装进度">
          <StackPanel>
            <TextBlock x:Name="InstallProgressText" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" />
            <ProgressBar x:Name="InstallProgressBar" Height="6" Maximum="100" Margin="0,10,0,0" AutomationProperties.Name="安装下载进度" />
          </StackPanel>
        </Border>
        <ItemsControl x:Name="ToolsList" AllowDrop="True" Drop="ToolsList_Drop" DragOver="ToolsList_DragOver"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource ToolCard}" Click="Tool_Click" Tag="{Binding}" ToolTip="点击打开；按住卡片拖动排序" PreviewMouseLeftButtonDown="ToolCard_PreviewMouseLeftButtonDown" PreviewMouseMove="ToolCard_PreviewMouseMove" PreviewMouseLeftButtonUp="ToolCard_PreviewMouseLeftButtonUp"><Button.ContextMenu><ContextMenu Opened="ToolCard_ContextMenuOpened" /></Button.ContextMenu><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><Border Width="32" Height="32" Background="{DynamicResource Surface.Hover}" HorizontalAlignment="Left"><TextBlock Text="{Binding Icon}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{Binding DisplayFavouriteSymbol}" Tag="{Binding}" HorizontalAlignment="Right" Foreground="#8B5C25" FontSize="16" Cursor="Hand" ToolTip="收藏或取消收藏" PreviewMouseLeftButtonDown="FavouriteStar_PreviewMouseLeftButtonDown" /></Grid><StackPanel Grid.Row="1" Margin="0,14,0,0"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding DisplayDescription}" Foreground="{DynamicResource Text.Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding DisplayVersionInfo}" Foreground="{DynamicResource Text.Secondary}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel><Grid Grid.Row="2"><TextBlock Text="{Binding DisplayType}" Foreground="{DynamicResource Text.Muted}" FontSize="11" /><TextBlock Text="{Binding DisplayActionText}" HorizontalAlignment="Right" Foreground="{DynamicResource Brand}" FontSize="11" /></Grid></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></ScrollViewer>
    </Grid>
  </DockPanel></AdornerDecorator>
</Window>
